# AQRS local environment template
# Copy to .env for local notes if desired. The current app reads environment
# variables directly from the shell.

# Telegram BotFather token.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Your Telegram chat id.
TELEGRAM_CHAT_ID=replace_with_chat_id

# Optional future MT5 credential placeholders.
# Prefer manual MT5 terminal login for now.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
